# Supabase 프로젝트 설정 > API 에서 복사한다.
# 이 두 값이 없으면 앱은 기기 저장소만 쓰는 데모 모드로 뜬다.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 아래 값은 앱 번들에 들어가면 안 된다. Edge Function 시크릿으로만 설정한다.
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set ANTHROPIC_MODEL=claude-opus-5   # 선택
