{
  "name": "footballbanghwa",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "db:push": "supabase db push",
    "fn:deploy": "supabase functions deploy",
    "build:demo": "EXPO_WEB_OUTPUT=single expo export --platform web --output-dir dist-demo && node scripts/build-demo.mjs",
    "db:test": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -f supabase/tests/rls_test.sql"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.14",
    "expo-clipboard": "^57.0.1",
    "expo-constants": "~57.0.12",
    "expo-crypto": "^57.0.1",
    "expo-device": "^57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "^57.0.3",
    "expo-image-manipulator": "^57.0.10",
    "expo-image-picker": "^57.0.11",
    "expo-linking": "~57.0.6",
    "expo-notifications": "^57.0.12",
    "expo-router": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "supabase": "^2.115.0",
    "typescript": "~6.0.3"
  }
}
