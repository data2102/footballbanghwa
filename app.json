{
  "expo": {
    "name": "우리팀 매니저",
    "slug": "footballbanghwa",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "footballbanghwa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.footballbanghwa.app",
      "infoPlist": {
        "NSCameraUsageDescription": "화이트보드나 손으로 쓴 명단을 바로 찍어서 올리려면 카메라 접근이 필요해요.",
        "NSPhotoLibraryUsageDescription": "명단 사진이나 프로필 사진을 올리려면 사진첩 접근이 필요해요."
      }
    },
    "android": {
      "package": "com.footballbanghwa.app",
      "adaptiveIcon": {
        "backgroundColor": "#F2F4F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F4F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "명단 사진이나 프로필 사진을 올리려면 사진첩 접근이 필요해요.",
          "cameraPermission": "화이트보드나 손으로 쓴 명단을 바로 찍어서 올리려면 카메라 접근이 필요해요."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3182F6",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
